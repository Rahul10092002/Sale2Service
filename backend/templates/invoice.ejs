<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice <%= invoice.number %></title>
    <style>
        @page {
            size: A4;
            margin: 12mm 14mm 12mm 14mm;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10pt;
            line-height: 1.45;
            color: #111827;
            background: #fff;
            -webkit-font-smoothing: antialiased;
        }

        @media print {
            body {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .items-table th {
                background: #1e293b !important;
                color: #ffffff !important;
            }
        }
        
        .invoice-card {
            width: 100%;
            background: #fff;
            position: relative;
        }

        /* ── Header ── */
        .header-main {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 18px;
            gap: 20px;
        }

        .brand-section {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            flex: 1;
        }
        
        .logo-placeholder {
            width: 56px;
            height: 56px;
            background: #f8fafc;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            flex-shrink: 0;
        }

        .logo-placeholder img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
        
        .shop-info h1 {
            font-size: 16pt;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.02em;
            line-height: 1.2;
            margin-bottom: 3px;
        }

        .shop-meta {
            font-size: 8.5pt;
            color: #475569;
            line-height: 1.35;
        }

        .shop-meta strong {
            color: #1e293b;
        }
        
        /* ── Header Right: Tax Invoice Title & Number ── */
        .header-invoice-title {
            text-align: right;
            flex-shrink: 0;
        }

        .header-invoice-title h2 {
            font-size: 22pt;
            font-weight: 900;
            color: #0f172a;
            letter-spacing: -0.03em;
            line-height: 1.1;
            margin-bottom: 2px;
        }

        .invoice-num-row {
            font-size: 11pt;
            font-weight: 700;
            color: #2563eb;
            font-family: monospace;
            letter-spacing: 0.5px;
        }

        .status-badge {
            display: inline-block;
            padding: 2px 7px;
            border-radius: 4px;
            font-size: 8pt;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            text-align: center;
        }

        .status-paid { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
        .status-partial { background: #fef9c3; color: #a16207; border: 1px solid #fde047; }
        .status-pending { background: #fef9c3; color: #a16207; border: 1px solid #fde047; }
        .status-unpaid { background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; }

        /* ── Details Grid (Bill To / Invoice Details) ── */
        .details-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 20px;
            margin-bottom: 16px;
        }

        .info-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 10px 12px;
        }

        .section-title {
            font-size: 8.5pt;
            text-transform: uppercase;
            font-weight: 800;
            color: #475569;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 3px;
        }

        .customer-name {
            font-size: 10.5pt;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .info-row {
            font-size: 8.5pt;
            color: #475569;
            display: flex;
            justify-content: space-between;
            margin-bottom: 2px;
            line-height: 1.35;
        }

        .info-row span {
            color: #64748b;
        }

        .info-row strong {
            color: #0f172a;
            font-weight: 600;
        }

        /* ── Items Table ── */
        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 14px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            overflow: hidden;
        }

        .items-table th {
            background: #0f172a;
            color: #f8fafc;
            text-align: left;
            padding: 8px 9px;
            font-size: 8.5pt;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid #0f172a;
        }

        .items-table td {
            padding: 8px 9px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: top;
            font-size: 9pt;
            font-variant-numeric: tabular-nums;
        }

        .items-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }

        .items-table tr {
            page-break-inside: avoid;
        }

        .item-title {
            font-weight: 700;
            color: #0f172a;
            font-size: 9.5pt;
            line-height: 1.3;
        }

        .item-brand {
            font-size: 8pt;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
            margin-left: 4px;
        }

        .item-spec-line {
            font-size: 8pt;
            color: #64748b;
            margin-top: 2px;
            font-family: inherit;
        }

        .item-tag {
            display: inline-block;
            font-size: 8pt;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 3px;
            margin-top: 3px;
            margin-right: 4px;
        }

        .tag-warranty {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
        }

        .tag-pro-warranty {
            background: #fff7ed;
            color: #c2410c;
            border: 1px solid #ffedd5;
        }

        .tag-service-plan {
            background: #f0fdf4;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .tag-service {
            background: #f1f5f9;
            color: #334155;
            border: 1px solid #cbd5e1;
        }

        .item-notes {
            font-size: 8pt;
            color: #64748b;
            font-style: italic;
            margin-top: 2px;
        }

        /* ── Totals & Amount in Words ── */
        .bottom-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 20px;
            margin-top: 6px;
            align-items: flex-start;
        }

        .totals-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 10px 12px;
        }

        .total-line {
            display: flex;
            justify-content: space-between;
            padding: 3px 0;
            font-size: 8.5pt;
            color: #475569;
            font-variant-numeric: tabular-nums;
        }

        .total-line span {
            color: #64748b;
            font-weight: 400;
        }

        .total-line strong {
            color: #0f172a;
            font-weight: 700;
        }

        .grand-total {
            margin-top: 6px;
            padding: 8px 10px;
            background: #0f172a;
            color: #ffffff;
            border-radius: 5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 800;
            font-size: 11pt;
            font-variant-numeric: tabular-nums;
        }

        .grand-total span {
            color: #e2e8f0;
            font-size: 9pt;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .grand-total strong {
            color: #ffffff;
            font-size: 12pt;
        }

        .balance-due-line {
            margin-top: 6px;
            padding: 6px 8px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 4px;
            display: flex;
            justify-content: space-between;
            font-size: 9.5pt;
            font-weight: 800;
            color: #b91c1c;
            font-variant-numeric: tabular-nums;
        }

        .amount-in-words {
            font-size: 8pt;
            color: #334155;
            margin-top: 8px;
            padding-top: 6px;
            border-top: 1px dashed #cbd5e1;
            line-height: 1.35;
        }

        .amount-in-words strong {
            color: #0f172a;
            text-transform: uppercase;
            font-size: 8pt;
            display: block;
            margin-bottom: 1px;
            letter-spacing: 0.04em;
        }

        /* ── Terms & Signature Footer ── */
        .footer-section {
            margin-top: 22px;
            padding-top: 12px;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
        }

        .terms-box {
            flex: 1;
            font-size: 8pt;
            color: #64748b;
            line-height: 1.35;
        }

        .terms-box strong {
            color: #334155;
            display: block;
            margin-bottom: 2px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .terms-box ul {
            padding-left: 14px;
            margin-bottom: 4px;
        }

        .terms-box li {
            margin-bottom: 2px;
        }

        .signature-box {
            width: 200px;
            text-align: right;
            font-size: 8.5pt;
            color: #334155;
            flex-shrink: 0;
            padding-top: 20px;
        }

        .signature-line {
            margin-top: 36px;
            border-top: 1px solid #94a3b8;
            padding-top: 4px;
            font-weight: 700;
            color: #0f172a;
        }

        .computer-generated {
            margin-top: 12px;
            text-align: center;
            font-size: 8pt;
            color: #94a3b8;
            border-top: 1px dashed #f1f5f9;
            padding-top: 6px;
        }
    </style>
</head>
<body>
    <div class="invoice-card">
        <!-- ── Header ── -->
        <div class="header-main">
            <div class="brand-section">
                <% if (pdf_settings.show_logo && shop.logo_url) { %>
                <div class="logo-placeholder">
                    <img src="<%= shop.logo_url %>" alt="<%= shop.name %> Logo" />
                </div>
                <% } %>
                <div class="shop-info">
                    <% if (pdf_settings.show_shop_name) { %>
                    <h1><%= shop.name %></h1>
                    <% } %>
                    <div class="shop-meta">
                        <% if (pdf_settings.show_shop_gst && shop.gstNumber) { %><strong>GSTIN:</strong> <%= shop.gstNumber %><br><% } %>
                        <% if (pdf_settings.show_shop_address) { %>
                            <%= shop.address.street || '' %><% if (shop.address.street) { %>, <% } %>
                            <%= [shop.address.city, shop.address.state, shop.address.pincode].filter(Boolean).join(', ') %>
                        <% } %>
                        <% if (pdf_settings.show_shop_phone && shop.mobile) { %><br><strong>Phone:</strong> <%= shop.mobile %><% } %>
                        <% if (pdf_settings.show_shop_email && shop.email) { %> | <strong>Email:</strong> <%= shop.email %><% } %>
                    </div>
                </div>
            </div>

            <!-- ── Header Right: Tax Invoice Title & Number ── -->
            <div class="header-invoice-title">
                <h2><%= pdf_settings.header_title || 'TAX INVOICE' %></h2>
                <% if (pdf_settings.show_invoice_number) { %>
                <div class="invoice-num-row">#<%= invoice.number %></div>
                <% } %>
            </div>
        </div>

        <!-- ── Details Grid (Bill To / Invoice Details) ── -->
        <% const hasCustDetails = (pdf_settings.show_customer_name && customer.name) || (pdf_settings.show_customer_address && customer.address && (customer.address.street || customer.address.city || customer.address.state)) || (pdf_settings.show_customer_mobile && customer.mobile) || (pdf_settings.show_customer_gst && customer.gstNumber) || (pdf_settings.show_customer_email && customer.email); %>
        <% const hasInvDetails = (pdf_settings.show_invoice_date && invoice.date) || (pdf_settings.show_due_date && invoice.dueDate) || pdf_settings.show_payment_status || (pdf_settings.show_payment_mode && (invoice.payment_status === 'PAID' || invoice.payment_status === 'PARTIAL')) || (pdf_settings.show_reverse_charge && shop.gstNumber); %>

        <% if (hasCustDetails || hasInvDetails) { %>
        <div class="details-grid">
            <% if (hasCustDetails) { %>
            <div class="info-card">
                <div class="section-title">Billed To (Customer Details)</div>
                <% if (pdf_settings.show_customer_name && customer.name) { %>
                <div class="customer-name"><%= customer.name %></div>
                <% } %>
                <div class="shop-meta">
                    <% if (pdf_settings.show_customer_address && customer.address && (customer.address.street || customer.address.city || customer.address.state)) { %>
                        <%= customer.address.street || '' %><% if (customer.address.street) { %>, <% } %>
                        <%= [customer.address.city, customer.address.state, customer.address.pincode].filter(Boolean).join(', ') %><br>
                    <% } %>
                    <% if (pdf_settings.show_customer_mobile && customer.mobile) { %><strong>Phone / WhatsApp:</strong> <%= customer.mobile %><br><% } %>
                    <% if (pdf_settings.show_customer_gst && customer.gstNumber) { %><strong>GSTIN:</strong> <%= customer.gstNumber %><br><% } %>
                    <% if (pdf_settings.show_customer_email && customer.email) { %><strong>Email:</strong> <%= customer.email %><br><% } %>
                </div>
            </div>
            <% } %>

            <% if (hasInvDetails) { %>
            <div class="info-card">
                <div class="section-title">Invoice Details</div>
                <% if (pdf_settings.show_invoice_date && invoice.date) { %>
                <div class="info-row">
                    <span>Invoice Date:</span>
                    <strong><%= invoice.date %></strong>
                </div>
                <% } %>
                <% if (pdf_settings.show_due_date && invoice.dueDate) { %>
                <div class="info-row">
                    <span>Due Date:</span>
                    <strong style="color: <%= invoice.isOverdue ? '#b91c1c' : '#0f172a' %>;"><%= invoice.dueDate %></strong>
                </div>
                <% } %>
                <% if (pdf_settings.show_payment_status) { %>
                <div class="info-row" style="align-items: center; margin-top: 3px; margin-bottom: 3px;">
                    <span>Payment Status:</span>
                    <span class="status-badge status-<%= (invoice.payment_status || 'UNPAID').toLowerCase() %>"><%= invoice.payment_status || 'UNPAID' %></span>
                </div>
                <% } %>
                <% if (pdf_settings.show_payment_mode && (invoice.payment_status === 'PAID' || invoice.payment_status === 'PARTIAL')) { %>
                <div class="info-row">
                    <span>Payment Mode:</span>
                    <strong><%= invoice.paymentMode %></strong>
                </div>
                <% } %>
                <% if (pdf_settings.show_reverse_charge && shop.gstNumber) { %>
                <div class="info-row">
                    <span>Reverse Charge:</span>
                    <strong>No</strong>
                </div>
                <% } %>
            </div>
            <% } %>
        </div>
        <% } %>

        <!-- ── Items Table ── -->
        <% const visibleColCount = 2 + (pdf_settings.show_hsn_column ? 1 : 0) + (pdf_settings.show_qty_column ? 1 : 0) + (pdf_settings.show_rate_column ? 1 : 0) + (pdf_settings.show_taxable_column ? 1 : 0) + (pdf_settings.show_tax_column ? 1 : 0); %>
        <table class="items-table">
            <thead>
                <tr>
                    <th style="width: 28px; text-align: center;">#</th>
                    <th>Item & Description</th>
                    <% if (pdf_settings.show_hsn_column) { %><th style="width: 72px; text-align: center;">HSN / SAC</th><% } %>
                    <% if (pdf_settings.show_qty_column) { %><th style="width: 40px; text-align: center;">Qty</th><% } %>
                    <% if (pdf_settings.show_rate_column) { %><th style="width: 70px; text-align: right;">Rate</th><% } %>
                    <% if (pdf_settings.show_taxable_column) { %><th style="width: 70px; text-align: right;">Taxable</th><% } %>
                    <% if (pdf_settings.show_tax_column) { %><th style="width: 65px; text-align: right;">Tax</th><% } %>
                    <th style="width: 80px; text-align: right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <% if (!items || items.length === 0) { %>
                <tr>
                    <td colspan="<%= visibleColCount %>" style="text-align: center; color: #64748b; padding: 16px;">No items in this invoice</td>
                </tr>
                <% } else { %>
                    <% items.forEach(function(item, i) { %>
                    <tr>
                        <td style="text-align: center; color: #64748b;"><%= i + 1 %></td>
                        <td>
                            <div class="item-title">
                                <%= item.productName %>
                                <% if (pdf_settings.show_item_brand && item.company && item.company !== 'N/A' && !item.productName.toLowerCase().includes(item.company.toLowerCase())) { %>
                                    <span class="item-brand">(<%= item.company %>)</span>
                                <% } %>
                                <% if (item.isService) { %>
                                    <span class="item-tag tag-service">[<%= item.serviceCategory || 'SERVICE' %>]</span>
                                <% } %>
                            </div>

                            <% const specParts = []; %>
                            <% if (pdf_settings.show_item_model && item.modelNumber && item.modelNumber !== 'N/A') { specParts.push('Model: ' + item.modelNumber); } %>
                            <% if (pdf_settings.show_item_serial && item.serialNumber && item.serialNumber !== 'N/A' && !item.serialNumber.startsWith('SRV-')) { specParts.push('S/N: ' + item.serialNumber); } %>
                            <% if (item.capacityRating || item.voltage) { specParts.push([item.capacityRating, item.voltage].filter(Boolean).join(' · ')); } %>
                            <% if (specParts.length > 0) { %>
                                <div class="item-spec-line"><%= specParts.join(' | ') %></div>
                            <% } %>

                            <% if (item.batteryLine) { %>
                                <div class="item-spec-line"><%= item.batteryLine %></div>
                            <% } %>

                            <% if (pdf_settings.show_item_warranty && item.warrantyText) { %>
                                <div>
                                    <span class="item-tag tag-warranty">Warranty: <%= item.warrantyText %></span>
                                    <% if (item.proWarrantyText) { %>
                                        <span class="item-tag tag-pro-warranty"><%= item.proWarrantyText %></span>
                                    <% } %>
                                </div>
                            <% } %>

                            <% if (pdf_settings.show_item_service_plan && item.servicePlanSummary) { %>
                                <div>
                                    <span class="item-tag tag-service-plan"><%= item.servicePlanSummary %></span>
                                </div>
                            <% } %>

                            <% if (pdf_settings.show_item_notes && item.notes) { %>
                                <div class="item-notes">Note: <%= item.notes %></div>
                            <% } %>

                            <% if (item.isService && item.warrantyPeriod && item.warrantyPeriod !== 'N/A') { %>
                                <div class="item-notes" style="color: #15803d; font-weight: 700;">Service Warranty: <%= item.warrantyPeriod %></div>
                            <% } %>
                        </td>
                        <% if (pdf_settings.show_hsn_column) { %><td style="text-align: center; color: #475569; font-size: 8pt;"><%= item.hsnCode || '—' %></td><% } %>
                        <% if (pdf_settings.show_qty_column) { %><td style="text-align: center; font-weight: 600;"><%= item.quantity %></td><% } %>
                        <% if (pdf_settings.show_rate_column) { %><td style="text-align: right;"><%= item.unitPrice %></td><% } %>
                        <% if (pdf_settings.show_taxable_column) { %><td style="text-align: right;"><%= item.taxableAmount || (item.unitPriceRaw !== undefined ? (item.unitPriceRaw * item.quantity).toFixed(2) : item.unitPrice) %></td><% } %>
                        <% if (pdf_settings.show_tax_column) { %><td style="text-align: right;"><%= item.taxAmount %></td><% } %>
                        <td style="text-align: right; font-weight: 700;"><%= item.amount %></td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>

        <!-- ── Bottom Grid (Notes on Left | Totals on Right) ── -->
        <div class="bottom-grid">
            <div class="bottom-left-section">
                <% const hasBankInfo = shop.bank_details && (shop.bank_details.account_number || shop.bank_details.bank_name || shop.bank_details.ifsc_code || shop.bank_details.upi_id); %>
                <% const showBank = pdf_settings.show_bank_details && hasBankInfo; %>
                <% const showQr = pdf_settings.show_upi_qr && upiQRCode; %>
                <% if (showQr || showBank) { %>
                <div class="info-card" style="margin-bottom: 8px;">
                    <div class="section-title">Payment & Bank Details</div>
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <% if (showQr) { %>
                        <div style="text-align: center; flex-shrink: 0;">
                            <img src="<%= upiQRCode %>" alt="UPI QR Code" style="width: 95px; height: 95px; border: 1px solid #cbd5e1; border-radius: 4px; padding: 2px; background: #fff; display: block; margin: 0 auto;" />
                            <div style="font-size: 7.5pt; font-weight: 700; color: #1e293b; margin-top: 2px; text-transform: uppercase; letter-spacing: 0.03em;">Scan & Pay UPI</div>
                        </div>
                        <% } %>
                        <% if (showBank) { %>
                        <div style="flex: 1; min-width: 0;">
                            <% if (shop.bank_details?.account_holder_name) { %>
                            <div class="info-row"><span>A/C Holder:</span><strong><%= shop.bank_details.account_holder_name %></strong></div>
                            <% } %>
                            <% if (shop.bank_details?.bank_name) { %>
                            <div class="info-row"><span>Bank Name:</span><strong><%= shop.bank_details.bank_name %></strong></div>
                            <% } %>
                            <% if (shop.bank_details?.account_number) { %>
                            <div class="info-row"><span>A/C Number:</span><strong style="font-family: monospace; letter-spacing: 0.5px;"><%= shop.bank_details.account_number %></strong></div>
                            <% } %>
                            <% if (shop.bank_details?.ifsc_code) { %>
                            <div class="info-row"><span>IFSC Code:</span><strong style="font-family: monospace; letter-spacing: 0.5px;"><%= shop.bank_details.ifsc_code %></strong></div>
                            <% } %>
                            <% if (shop.bank_details?.upi_id) { %>
                            <div class="info-row"><span>UPI ID:</span><strong style="color: #2563eb;"><%= shop.bank_details.upi_id %></strong></div>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } %>

                <% if (pdf_settings.show_notes && invoice.notes) { %>
                <div class="info-card">
                    <div class="section-title">Invoice Notes</div>
                    <p style="font-size: 8pt; color: #475569; white-space: pre-line;"><%= invoice.notes %></p>
                </div>
                <% } %>
            </div>

            <!-- Right: Totals Block -->
            <% const hasTotalsVisible = pdf_settings.show_subtotal || pdf_settings.show_discount || pdf_settings.show_exchange_price || pdf_settings.show_tax_breakdown || pdf_settings.show_amount_paid || pdf_settings.show_balance_due || pdf_settings.show_amount_in_words; %>
            <% if (hasTotalsVisible) { %>
            <div class="totals-card">
                <div>
                    <div class="section-title">Summary & Tax Breakdown</div>
                    <% if (pdf_settings.show_subtotal) { %>
                    <div class="total-line">
                        <span>Subtotal:</span>
                        <strong><%= totals.subtotal %></strong>
                    </div>
                    <% } %>

                    <% if (pdf_settings.show_discount && totals.discountRaw > 0) { %>
                    <div class="total-line">
                        <span>Discount:</span>
                        <strong style="color: #b91c1c;">-<%= totals.discount %></strong>
                    </div>
                    <% } %>

                    <% if (pdf_settings.show_exchange_price && totals.oldItemExchangePriceRaw > 0) { %>
                    <div class="total-line">
                        <span>Old Item / Exchange:</span>
                        <strong style="color: #c2410c;">-<%= totals.oldItemExchangePrice %></strong>
                    </div>
                    <% } %>

                    <% if (pdf_settings.show_taxable_column) { %>
                    <div class="total-line">
                        <span>Taxable Amount:</span>
                        <strong><%= totals.taxableAmount || totals.subtotal %></strong>
                    </div>
                    <% } %>

                    <% if (pdf_settings.show_tax_breakdown) { %>
                        <% if (totals.isInterState) { %>
                        <div class="total-line">
                            <span>IGST (<%= totals.igstRate %>):</span>
                            <strong><%= totals.igstAmount %></strong>
                        </div>
                        <% } else { %>
                        <div class="total-line">
                            <span>CGST (<%= totals.cgstRate %>):</span>
                            <strong><%= totals.cgstAmount %></strong>
                        </div>

                        <div class="total-line">
                            <span>SGST (<%= totals.sgstRate %>):</span>
                            <strong><%= totals.sgstAmount %></strong>
                        </div>
                        <% } %>
                    <% } %>

                    <!-- Grand Total -->
                    <div class="grand-total">
                        <span>Total (Incl. of Tax)</span>
                        <strong><%= totals.total %></strong>
                    </div>

                    <% if (pdf_settings.show_amount_paid && payment.amountPaidRaw > 0) { %>
                    <div class="total-line" style="margin-top: 6px; padding-top: 4px; border-top: 1px solid #e2e8f0;">
                        <span>Amount Paid:</span>
                        <strong style="color: #15803d;"><%= payment.amount_paid %></strong>
                    </div>
                    <% } %>

                    <% if (pdf_settings.show_balance_due && payment.amountDueRaw > 0) { %>
                    <div class="balance-due-line">
                        <span>Balance Due</span>
                        <strong><%= payment.amount_due %></strong>
                    </div>
                    <% } %>
                </div>

                <% if (pdf_settings.show_amount_in_words && totals.amountInWords) { %>
                <div class="amount-in-words">
                    <strong>Amount in Words:</strong>
                    <%= totals.amountInWords %>
                </div>
                <% } %>
            </div>
            <% } %>
        </div>

        <!-- ── Footer: Terms & Authorized Signatory ── -->
        <% const showTermsSection = pdf_settings.show_terms && pdf_settings.terms_and_conditions && pdf_settings.terms_and_conditions.length > 0; %>
        <% const showSigSection = pdf_settings.show_signature; %>
        <% if (showTermsSection || showSigSection) { %>
        <div class="footer-section">
            <div class="terms-box">
                <% if (showTermsSection) { %>
                    <strong>Terms & Conditions</strong>
                    <ul>
                        <% pdf_settings.terms_and_conditions.forEach(function(term) { %>
                            <li><%= term %></li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>

            <% if (showSigSection) { %>
            <div class="signature-box">
                <div>For <strong><%= shop.name %></strong></div>
                <div class="signature-line">Authorised Signatory</div>
            </div>
            <% } %>
        </div>
        <% } %>

        <% if (pdf_settings.show_footer_note && pdf_settings.footer_note) { %>
        <div class="computer-generated">
            <%= pdf_settings.footer_note %>
        </div>
        <% } %>
    </div>
</body>
</html>
